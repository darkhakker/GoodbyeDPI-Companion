{
  "manifest_version": 3,
  "name": "GoodbyeDPI Companion",
  "version": "0.1.4",
  "minimum_chrome_version": "120",
  "description": "Управление GoodbyeDPI для выбранных сайтов с локальным обнаружением ресурсов.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "webRequest",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GoodbyeDPI Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
